digraph compiler {
  graph [rankdir=LR, fontname="Helvetica", nodesep=0.3, ranksep=0.35, pad=0.15];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, color="#3b4a6b", fillcolor="#eef2f8", penwidth=1.2, margin="0.12,0.07"];
  edge  [color="#3b4a6b", arrowsize=0.7, fontname="Helvetica", fontsize=8.5];
  rules [label="Rule file\n26 regex rules", fillcolor="#fff7e6", color="#b07d1a"];
  lex   [label="Lexer\ntokens"];
  parse [label="Recursive-descent\nparser → AST\n(rejects \\d, \\b, \\1, (?= …)"];
  nfa   [label="Thompson\nconstruction\n→ ε-NFA"];
  dfa   [label="Subset construction\nε-closure, accept masks\n→ combined DFA"];
  tab   [label="DFA transition tables\nread-only, shared\nby all workers", shape=cylinder, fillcolor="#e8f4ea", color="#2f7a43"];
  rules -> lex -> parse -> nfa -> dfa -> tab;
}
