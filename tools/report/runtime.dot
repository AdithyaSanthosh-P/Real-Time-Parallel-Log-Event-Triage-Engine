digraph runtime {
  graph [rankdir=TB, ordering=out, fontname="Helvetica", nodesep=0.35, ranksep=0.42, pad=0.15];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, color="#3b4a6b", fillcolor="#eef2f8", penwidth=1.2, margin="0.14,0.07"];
  edge  [color="#3b4a6b", arrowsize=0.7, fontname="Helvetica", fontsize=8.5, fontcolor="#555555"];

  input  [label="Log / event stream  (file, stdin, pipe)", fillcolor="#fff7e6", color="#b07d1a"];
  reader [label="Reader + Dispatcher\nsplit lines · normalise (URL-decode) · parse timestamps\nbuild batches · dispatch round-robin / least-loaded"];
  pool   [label="Job pool\npreallocated batches,\nrecycled (no malloc)", shape=cylinder, fillcolor="#f3f3f3", color="#777777"];
  tab    [label="Shared DFA tables\n(read-only, no locks)", shape=cylinder, fillcolor="#e8f4ea", color="#2f7a43"];

  subgraph cluster_w {
    label="Worker threads  (-w N, pinned to cores)"; style="rounded,dashed"; color="#8a94a8"; fontcolor="#3b4a6b"; fontsize=10;
    w1 [label="Worker 1\nDFA / POSIX match\nvalidators · extraction\nPII masking"];
    w2 [label="Worker N\n…"];
    wn [label="Worker 2\nDFA / POSIX match\nvalidators · extraction\nPII masking"];
  }
  agg   [label="Aggregator\nrule scores → noisy-OR confidence per category\nmulti-label (τ = 0.5) · primary · severity"];
  corr  [label="Correlator\nrestores input order · sliding windows per source IP\nbrute force · password spray · fail-then-success · error storm"];
  route [label="Router\nJSONL records · 1 Hz stats line"];
  alerts [label="alerts.jsonl\nHIGH / CRITICAL", shape=note, fillcolor="#fbe9e9", color="#a33a3a"];
  store  [label="store.jsonl\nall lines", shape=note, fillcolor="#f3f3f3", color="#555555"];
  pii    [label="pii_quarantine.jsonl\nmasked PII", shape=note, fillcolor="#f1ebf8", color="#6a3fa0"];

  input -> reader;
  reader -> w1 [label=" SPSC ring"]; reader -> w2 [label=" SPSC ring"]; reader -> wn [label=" SPSC ring"];
  w1 -> agg; w2 -> agg [label=" SPSC rings"]; wn -> agg;
  agg -> corr [label=" SPSC ring"];
  corr -> route [label=" SPSC ring"];
  route -> alerts; route -> store; route -> pii;
  pool -> reader [style=dashed, color="#777777", label=" free jobs"];
  tab -> w1 [style=dotted, color="#2f7a43", arrowhead=none, label=" used by\n every worker", fontcolor="#2f7a43"];
  {rank=same; pool; reader; tab;}
}
